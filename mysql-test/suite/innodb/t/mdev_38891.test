--source include/have_innodb.inc
--source include/have_debug.inc
--source include/not_embedded.inc

--echo #
--echo # MDEV-38891 Innodb crash at shutdown/dict_stats
--echo #

# Freeze dict_stats_func so shutdown races with the callback.
# Without the fix, the callback lazily constructs a THD after the
# plugin subsystem has started tearing down and crashes.
SET GLOBAL debug_dbug="+d,mdev_38891_sleep_in_bg_thread";

# Arm the background timer after the sleep is enabled.
CREATE TABLE t1 (a INT PRIMARY KEY) ENGINE=InnoDB
STATS_PERSISTENT=1 STATS_AUTO_RECALC=1;
INSERT INTO t1 VALUES (1),(2),(3);

--source include/restart_mysqld.inc

DROP TABLE t1;
